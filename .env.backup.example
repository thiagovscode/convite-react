# ============================================================
# CONFIGURAÇÃO DE BACKUP AUTOMÁTICO — CASAMENTO TAINARA & THIAGO
# ============================================================

# String de conexão com o MongoDB (Atlas ou Local)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/convite-casamento?retryWrites=true&w=majority

# Nome da collection monitorada
COLLECTION_NAME=rsvp_casamento

# Intervalo em segundos para checagem de novos RSVPs (padrão: 10)
CHECK_INTERVAL_SECONDS=10

# Configurações de SMTP para Envio do E-mail com Backup Anexo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-aplicativo-google

# E-mail de destino que receberá o backup com os dados da confirmação
BACKUP_EMAIL_TO=seu-email@gmail.com
BACKUP_EMAIL_FROM=seu-email@gmail.com
